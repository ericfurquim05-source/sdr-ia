# Chave da API da Retell (painel Retell > API Keys)
RETELL_API_KEY=

# IDs dos agentes criados no painel da Retell
RETELL_AGENT_FRIO_ID=
RETELL_AGENT_QUENTE_ID=

# Número de origem das chamadas (comprado/importado na Retell)
RETELL_FROM_NUMBER=+5511999999999

# Prefixo de discagem exigido pelo tronco SIP (só os dígitos).
# O site cola esse prefixo na frente de DDD + número.
# Ex.: 968655 + 51980554326 = 96865551980554326
# Deixe em branco para discar no padrão internacional (+55...).
RETELL_PREFIXO_DISCAGEM=968655

# Banco de dados da fila de ligações.
# Na Vercel: Storage -> Create Database -> Postgres (Neon) -> Connect ao projeto.
# A POSTGRES_URL é preenchida automaticamente; localmente, copie do painel.
POSTGRES_URL=

# Segredo para assinar o cookie de sessão (login).
# Gere um valor longo e aleatório, ex.: openssl rand -base64 32
SESSAO_SEGREDO=

# Duração média estimada por ligação (minutos), usada só para
# bloquear a campanha quando o saldo não cobre a lista.
MINUTOS_ESTIMADOS_POR_LIGACAO=1.5

# Crédito de boas-vindas para contas novas (0 = desligado)
BONUS_BOAS_VINDAS=0

# Pausa entre as tentativas do MESMO número, em minutos.
# 0 = redisca imediatamente (padrao): insiste no numero ate atender
# ou estourar as 7 tentativas, so entao passa para o proximo contato.
# Se colocar 20, por exemplo, o numero sai da fila por 20 min e a
# discagem segue com os outros contatos enquanto isso.
MINUTOS_ENTRE_TENTATIVAS=0

# Ligações simultâneas por cliente. Mais paralelo = a lista roda mais
# rápido = cada contato é rediscado mais vezes no mesmo dia.
# Comece em 3 e suba conforme o tronco SIP aguentar (Retell permite até 10).
CONCORRENCIA_MAXIMA=3

# Janela de discagem (horário de Brasília). Fora dela, a fila espera.
# Padrão: liga das 8h até antes das 21h.
HORA_INICIO_LIGACOES=8
HORA_FIM_LIGACOES=21

# ---- WhatsApp oficial (Meta Cloud API / Facebook Business) ----
# Meta for Developers -> seu app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nome do template aprovado usado no follow-up automático
WHATSAPP_TEMPLATE=followup_ligacao
# Senha que você inventa e repete na configuração do webhook da Meta
WHATSAPP_VERIFY_TOKEN=
# Segundos mínimos de conversa para o follow-up automático disparar.
# Padrão 60: abaixo de um minuto costuma ser recusa rápida, não conversa.
# Só recebe WhatsApp quem REALMENTE falou (ou quem teve áudio ruim).
# Nunca dispara para quem não atendeu: queima o número na Meta.
WHATSAPP_APOS_SEGUNDOS=60

# ---- IA de conversa no WhatsApp (omnichannel) ----
# Chave em console.anthropic.com -> API Keys. Com WHATSAPP_AUTORESPOSTA=1,
# a IA lê a transcrição da ligação e continua a conversa sozinha.
ANTHROPIC_API_KEY=
WHATSAPP_AUTORESPOSTA=0

# Recarga sem gateway (ambiente de teste): credita direto ao clicar.
# DESLIGUE (0) quando conectar o gateway de pagamento real.
RECARGA_MODO_TESTE=1

# Segundos mínimos para uma ligação gerar cobrança.
# 0 = cobra todo segundo conectado (inclusive caixa postal), que é o
# padrão, já que a operadora cobra esses segundos de nós.
SEGUNDOS_MINIMOS_COBRANCA=0
