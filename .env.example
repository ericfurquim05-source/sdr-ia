# Chave da API da Retell (painel Retell > API Keys)
RETELL_API_KEY=

# IDs dos agentes criados no painel da Retell
RETELL_AGENT_FRIO_ID=
RETELL_AGENT_QUENTE_ID=

# Número de origem das chamadas (comprado/importado na Retell)
RETELL_FROM_NUMBER=+5511999999999

# Prefixo de discagem exigido pelo tronco SIP (só os dígitos).
# O site cola esse prefixo na frente de DDD + número.
# Ex.: 968655 + 51980554326 = 96865551980554326
# Deixe em branco para discar no padrão internacional (+55...).
RETELL_PREFIXO_DISCAGEM=968655

# Banco de dados da fila de ligações.
# Na Vercel: Storage -> Create Database -> Postgres (Neon) -> Connect ao projeto.
# A POSTGRES_URL é preenchida automaticamente; localmente, copie do painel.
POSTGRES_URL=

# Segredo para assinar o cookie de sessão (login).
# Gere um valor longo e aleatório, ex.: openssl rand -base64 32
SESSAO_SEGREDO=

# Duração média estimada por ligação (minutos), usada só para
# bloquear a campanha quando o saldo não cobre a lista.
MINUTOS_ESTIMADOS_POR_LIGACAO=1.5

# Crédito de boas-vindas para contas novas (0 = desligado)
BONUS_BOAS_VINDAS=0

# Pausa entre as tentativas do MESMO número, em minutos.
# 0 = redisca imediatamente (padrao): insiste no numero ate atender
# ou estourar as 7 tentativas, so entao passa para o proximo contato.
# Se colocar 20, por exemplo, o numero sai da fila por 20 min e a
# discagem segue com os outros contatos enquanto isso.
MINUTOS_ENTRE_TENTATIVAS=0

# Ligações simultâneas por cliente. Mais paralelo = a lista roda mais
# rápido = cada contato é rediscado mais vezes no mesmo dia.
# Padrão 5. A Retell permite até 10 — suba se o tronco SIP aguentar.
# Se começarem a aparecer erros de operadora, baixe este número.
CONCORRENCIA_MAXIMA=5

# Janela de discagem (horário de Brasília). Fora dela, a fila espera.
# Padrão: horário comercial, das 8h até antes das 18h.
# Ligação à noite para empresa quase não converte.
HORA_INICIO_LIGACOES=8
HORA_FIM_LIGACOES=18

# ---- WhatsApp oficial (Meta Cloud API / Facebook Business) ----
# Meta for Developers -> seu app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nome do template aprovado usado no follow-up automático
WHATSAPP_TEMPLATE=followup_ligacao
# Senha que você inventa e repete na configuração do webhook da Meta
WHATSAPP_VERIFY_TOKEN=
# Segundos mínimos de conversa para o follow-up automático disparar.
# Padrão 60: abaixo de um minuto costuma ser recusa rápida, não conversa.
# Só recebe WhatsApp quem REALMENTE falou (ou quem teve áudio ruim).
# Nunca dispara para quem não atendeu: queima o número na Meta.
WHATSAPP_APOS_SEGUNDOS=60

# ---- IA de conversa no WhatsApp (omnichannel) ----
# Chave em console.anthropic.com -> API Keys. Com WHATSAPP_AUTORESPOSTA=1,
# a IA lê a transcrição da ligação e continua a conversa sozinha.
ANTHROPIC_API_KEY=
WHATSAPP_AUTORESPOSTA=0

# Recarga sem gateway (ambiente de teste): credita direto ao clicar.
# DESLIGUE (0) quando conectar o gateway de pagamento real.
RECARGA_MODO_TESTE=1

# Segundos mínimos para uma ligação gerar cobrança.
# Ligação de 1 ou 2 segundos costuma ser artefato de conexão, não
# conversa: cobrar isso gera reclamação. Padrão 3 segundos.
SEGUNDOS_MINIMOS_COBRANCA=3

# Faixas em que a IA pode marcar REUNIÃO (diferente do horário de ligar).
# Formato "inicio-fim", fim exclusivo, separado por vírgula.
# Padrão: manhã das 8h às 11h e tarde das 14h às 19h.
JANELAS_AGENDAMENTO=8-11,14-19

# ---- Administração e recuperação de senha ----
# E-mail que terá acesso ao painel /admin (suporte aos clientes)
ADMIN_EMAIL=
# Endereço público do site, usado nos links de redefinição de senha
URL_DO_SITE=https://sdr-ia-six.vercel.app
# Envio de e-mail (opcional). Sem isso, o link de senha é gerado no
# painel /admin para você enviar ao cliente por WhatsApp.
RESEND_API_KEY=
EMAIL_REMETENTE=

# Saldo (R$) a partir do qual o cliente recebe aviso no extrato,
# para recarregar antes da campanha parar sozinha.
SALDO_AVISO=200

# Segredo que autentica o cron da Vercel ao acionar a fila.
# Sem ele, a rota /api/campanhas/processar só aceita cliente logado.
# Gere um valor aleatório longo e use o mesmo na configuração do cron.
CRON_SECRET=

# ---- WhatsApp via Z-API (alternativa mais simples que a Meta) ----
# Conecta lendo um QR code, sem template aprovado nem verificação.
# Se as variáveis da Meta também estiverem preenchidas, a Meta tem prioridade.
# No painel da Z-API: Instâncias Web -> Dados da instância.
ZAPI_INSTANCIA=
ZAPI_TOKEN=
# Token de segurança da conta (menu Segurança). Obrigatório em alguns planos.
ZAPI_CLIENT_TOKEN=

# Segundos entre um follow-up automático e o próximo. Evita rajada, que é
# o comportamento que derruba número, sem travar campanha grande.
WHATSAPP_SEGUNDOS_ENTRE_DISPAROS=25
# Teto de mensagens automáticas em 24h, por cliente. Proteção do número.
WHATSAPP_MAXIMO_POR_DIA=150

# ---- Segurança dos webhooks (blindagem das rotas públicas) ----
# Segredo da URL do webhook da Z-API. Depois de preencher, atualize as
# URLs no painel da Z-API para .../api/whatsapp/zapi?segredo=ESTE_VALOR
# Gere com: openssl rand -hex 24
ZAPI_WEBHOOK_SEGREDO=
# Segredo das rotas de agenda. Adicione o cabeçalho x-agenda-segredo
# com este valor nas DUAS custom functions da Retell (consultar_horarios
# e agendar_reuniao), campo Headers.
AGENDA_SEGREDO=
# App Secret do aplicativo na Meta (só se voltar a usar a API oficial).
META_APP_SECRET=
# EMERGÊNCIA: 1 desliga todas as validações acima (diagnóstico apenas).
WEBHOOKS_SEM_ASSINATURA=0

# ---- Transcrição de áudio recebido no WhatsApp ----
# Sem isso, o áudio do lead chega como "[áudio recebido]" e a IA
# precisa pedir para ele escrever. Custo ~R$ 0,03 por minuto.
OPENAI_API_KEY=
OPENAI_MODELO_AUDIO=whisper-1
